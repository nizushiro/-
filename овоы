biblioteka = []

while True:
    print("\n=== BIBLIOTEKA ===")
    print("1. Dodaj książkę")
    print("2. Pokaż książki")
    print("3. Wypożycz książkę")
    print("4. Zwróć książkę")
    print("5. Pokaż dostępne książki")
    print("6. Zakończ")

    wybor = input("Wybierz opcję: ")

    if wybor == "1":
        tytul = input("Podaj tytuł książki: ")
        autor = input("Podaj autora: ")

        biblioteka.append({
            "tytul": tytul,
            "autor": autor,
            "dostepna": True
        })

        print("Dodano książkę!")

    elif wybor == "2":
        if len(biblioteka) == 0:
            print("Biblioteka jest pusta.")
        else:
            for ksiazka in biblioteka:
                print(ksiazka["tytul"], "-", ksiazka["autor"])

    elif wybor == "3":
        tytul = input("Podaj tytuł książki: ")
        znaleziono = False

        for ksiazka in biblioteka:
            if ksiazka["tytul"] == tytul and ksiazka["dostepna"]:
                ksiazka["dostepna"] = False
                print("Wypożyczono książkę!")
                znaleziono = True
                break

        if not znaleziono:
            print("Książka nie jest dostępna.")

    elif wybor == "4":
        tytul = input("Podaj tytuł książki: ")
        znaleziono = False

        for ksiazka in biblioteka:
            if ksiazka["tytul"] == tytul and not ksiazka["dostepna"]:
                ksiazka["dostepna"] = True
                print("Zwrócono książkę!")
                znaleziono = True
                break

        if not znaleziono:
            print("Nie znaleziono wypożyczonej książki.")

    elif wybor == "5":
        znaleziono = False

        for ksiazka in biblioteka:
            if ksiazka["dostepna"]:
                print(ksiazka["tytul"], "-", ksiazka["autor"])
                znaleziono = True

        if not znaleziono:
            print("Brak dostępnych książek.")

    elif wybor == "6":
        print("Do widzenia!")
        break

    else:
        print("Nieprawidłowy wybór!")
